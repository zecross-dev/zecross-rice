#!/usr/bin/env python3
"""zdiscord — contrôle des vocaux Discord via le RPC local du client (Linux ET Windows).

  zdiscord setup             enregistre le Client ID + secret de TON app Discord (demandés au clavier)
  zdiscord login             autorise l'app (fenêtre de confirmation dans Discord)
  zdiscord status            état actuel en JSON (salon, membres, muet/casque)
  zdiscord channels          salons vocaux où il y a du monde (pour les rejoindre)
                             amis : marqués d'une ☆ dans le menu (~/.config/zdiscord/friends.json),
                             Discord ne donnant pas la liste d'amis aux apps non validées
  zdiscord mute | deaf       bascule micro coupé / casque coupé
  zdiscord disconnect        quitte le vocal
  zdiscord join <channel_id> rejoint un salon vocal
  zdiscord daemon            flux continu : une ligne JSON par changement sur stdout,
                             commandes JSON sur stdin ({"cmd":"mute"}, {"cmd":"join","id":"…"}, …)

Aucune donnée n'est envoyée ailleurs que sur ta machine (client Discord local) et à
discord.com pour l'échange/rafraîchissement du jeton OAuth.
Config et jetons : ~/.config/zdiscord/ (Linux) ou %APPDATA%\\zdiscord\\ (Windows), droits restreints.
"""
import getpass
import json
import os
import queue
import socket
import struct
import sys
import threading
import time
import urllib.parse
import urllib.request
import uuid
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

WINDOWS = os.name == "nt"
CONF = Path(os.environ.get("APPDATA", "")) / "zdiscord" if WINDOWS else Path.home() / ".config/zdiscord"
SETTINGS = CONF / "config.json"
TOKEN = CONF / "token.json"
FRIENDS = CONF / "friends.json"  # {"ids": {"<id>": "<pseudo>"}, "channels": {"<id>": "<salon>"}} — ☆ / 📌 dans le menu
SCOPES = ["rpc", "rpc.voice.read", "rpc.voice.write", "identify"]
REDIRECT = "http://localhost"
OP_HANDSHAKE, OP_FRAME, OP_CLOSE, OP_PING, OP_PONG = range(5)
VOICE_TYPES = (2, 13)  # salon vocal, salon de conférence


# ------------------------------------------------------------------ stockage

def save_private(path: Path, data: dict):
    CONF.mkdir(parents=True, exist_ok=True)
    if not WINDOWS:
        os.chmod(CONF, 0o700)
    tmp = path.with_suffix(".tmp")
    if WINDOWS:
        tmp.write_text(json.dumps(data, indent=2))
    else:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump(data, f, indent=2)
    os.replace(tmp, path)


def load(path: Path) -> dict:
    try:
        return json.loads(path.read_text())
    except Exception:
        return {}


# ---------------------------------------------------------------- transport

class Transport:
    """Socket Unix (Linux) ou named pipe (Windows) vers le client Discord."""

    def __init__(self):
        self._sock = None
        self._pipe = None
        last = None
        for path in self._candidates():
            try:
                if WINDOWS:
                    self._pipe = open(path, "r+b", buffering=0)
                else:
                    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                    s.connect(path)
                    self._sock = s
                return
            except OSError as e:
                last = e
        raise ConnectionError(f"Discord n'est pas lancé (ou RPC indisponible) : {last}")

    @staticmethod
    def _candidates():
        if WINDOWS:
            return [rf"\\?\pipe\discord-ipc-{i}" for i in range(10)]
        base = os.environ.get("XDG_RUNTIME_DIR") or os.environ.get("TMPDIR") or "/tmp"
        dirs = [base, f"{base}/app/com.discordapp.Discord", f"{base}/snap.discord", f"{base}/.flatpak/com.discordapp.Discord/xdg-run"]
        return [f"{d}/discord-ipc-{i}" for d in dirs for i in range(10)]

    def send(self, op: int, payload: dict):
        data = json.dumps(payload).encode()
        frame = struct.pack("<II", op, len(data)) + data
        if WINDOWS:
            self._pipe.write(frame)
            self._pipe.flush()
        else:
            self._sock.sendall(frame)

    def _read(self, n: int) -> bytes:
        buf = b""
        while len(buf) < n:
            chunk = self._pipe.read(n - len(buf)) if WINDOWS else self._sock.recv(n - len(buf))
            if not chunk:
                raise ConnectionError("connexion Discord fermée")
            buf += chunk
        return buf

    def recv(self):
        op, length = struct.unpack("<II", self._read(8))
        return op, json.loads(self._read(length) or b"{}")

    def close(self):
        try:
            (self._pipe or self._sock).close()
        except Exception:
            pass


class RPC:
    def __init__(self, client_id: str, on_event=None):
        self.t = Transport()
        self.on_event = on_event
        self.pending = {}
        self.lock = threading.Lock()
        self.t.send(OP_HANDSHAKE, {"v": 1, "client_id": client_id})
        op, ready = self.t.recv()
        if op == OP_CLOSE or ready.get("evt") != "READY":
            raise ConnectionError(f"poignée de main refusée : {ready.get('message', ready)}")
        self.alive = True
        threading.Thread(target=self._loop, daemon=True).start()

    def _loop(self):
        try:
            while True:
                op, msg = self.t.recv()
                if op == OP_PING:
                    self.t.send(OP_PONG, msg)
                    continue
                if op == OP_CLOSE:
                    break
                nonce = msg.get("nonce")
                if nonce and nonce in self.pending:
                    self.pending.pop(nonce).put(msg)
                elif msg.get("cmd") == "DISPATCH" and self.on_event:
                    self.on_event(msg.get("evt"), msg.get("data") or {})
        except Exception:
            pass
        self.alive = False
        if self.on_event:
            self.on_event("__CLOSED__", {})

    def call(self, cmd: str, args=None, evt=None, timeout=15):
        nonce = str(uuid.uuid4())
        q = queue.Queue()
        self.pending[nonce] = q
        payload = {"cmd": cmd, "args": args or {}, "nonce": nonce}
        if evt:
            payload["evt"] = evt
        with self.lock:
            self.t.send(OP_FRAME, payload)
        try:
            msg = q.get(timeout=timeout)
        except queue.Empty:
            self.pending.pop(nonce, None)
            raise TimeoutError(f"{cmd} : pas de réponse de Discord")
        if msg.get("evt") == "ERROR":
            raise RuntimeError(f"{cmd} : {msg.get('data', {}).get('message', 'erreur')}")
        return msg.get("data") or {}


# --------------------------------------------------------------------- OAuth

def oauth_token(form: dict) -> dict:
    st = load(SETTINGS)
    form = {**form, "client_id": st["client_id"], "client_secret": st["client_secret"]}
    req = urllib.request.Request("https://discord.com/api/oauth2/token", data=urllib.parse.urlencode(form).encode(),
                                 headers={"Content-Type": "application/x-www-form-urlencoded",
                                          "User-Agent": "zdiscord (rice, 1.0)"})
    with urllib.request.urlopen(req, timeout=15) as r:
        tok = json.loads(r.read())
    tok["expires_at"] = time.time() + tok.get("expires_in", 604800) - 300
    save_private(TOKEN, tok)
    return tok


def access_token() -> str:
    tok = load(TOKEN)
    if not tok:
        raise PermissionError("pas autorisé : lance « zdiscord login »")
    if time.time() >= tok.get("expires_at", 0):
        tok = oauth_token({"grant_type": "refresh_token", "refresh_token": tok["refresh_token"]})
    return tok["access_token"]


def connect(on_event=None) -> RPC:
    st = load(SETTINGS)
    if not st.get("client_id"):
        raise PermissionError("pas configuré : lance « zdiscord setup »")
    rpc = RPC(st["client_id"], on_event)
    auth = rpc.call("AUTHENTICATE", {"access_token": access_token()})
    rpc.me = auth.get("user") or {}
    return rpc


def login():
    st = load(SETTINGS)
    rpc = RPC(st["client_id"])
    print("Confirme l'autorisation dans la fenêtre Discord…")
    code = rpc.call("AUTHORIZE", {"client_id": st["client_id"], "scopes": SCOPES}, timeout=120)["code"]
    oauth_token({"grant_type": "authorization_code", "code": code, "redirect_uri": REDIRECT})
    print("Autorisé ✔")


# ------------------------------------------------------------------- données

def avatar_url(user: dict) -> str:
    uid, av = user.get("id", "0"), user.get("avatar")
    if av:
        return f"https://cdn.discordapp.com/avatars/{uid}/{av}.png?size=64"
    return f"https://cdn.discordapp.com/embed/avatars/{(int(uid) >> 22) % 6}.png"


AVATARS = (Path(os.environ.get("LOCALAPPDATA", "")) / "zdiscord/avatars") if WINDOWS else Path.home() / ".cache/zdiscord/avatars"
# trois groupes de threads : les tâches (scan, commandes) n'attendent que des « feuilles »
# (appels RPC, téléchargements) qui n'attendent jamais rien -> pas d'interblocage
_POOL = ThreadPoolExecutor(max_workers=6)        # tâches
_RPC_POOL = ThreadPoolExecutor(max_workers=32)   # appels RPC en parallèle
_DL_POOL = ThreadPoolExecutor(max_workers=12)    # téléchargements d'avatars
_dl_lock = threading.Lock()
_dl_pending = set()
on_avatar_ready = None  # rappel posé par le démon : un avatar vient d'arriver -> on renvoie l'état


def _download(url: str, dest: Path):
    try:
        AVATARS.mkdir(parents=True, exist_ok=True)
        req = urllib.request.Request(url, headers={"User-Agent": "zdiscord (rice, 1.0)"})
        with urllib.request.urlopen(req, timeout=5) as r:
            data = r.read()
        tmp = dest.with_suffix(".part")
        tmp.write_bytes(data)
        os.replace(tmp, dest)
        ok = True
    except Exception:
        ok = False
    with _dl_lock:
        _dl_pending.discard(dest.name)
    if ok and on_avatar_ready:
        on_avatar_ready()


def avatar_file(user: dict, wait: bool = False) -> str:
    """Avatar en cache local (les barres d'état n'affichent que des fichiers).
    Jamais bloquant par défaut : si absent, téléchargé en arrière-plan et "" en attendant."""
    name = f"{user.get('id', '0')}-{user.get('avatar') or 'default'}.png"
    dest = AVATARS / name
    if dest.exists():
        return str(dest)
    with _dl_lock:
        first = name not in _dl_pending
        _dl_pending.add(name)
    if wait:
        if first:
            _download(avatar_url(user), dest)
        else:
            for _ in range(50):  # déjà en cours ailleurs : on attend jusqu'à 5 s
                if dest.exists() or name not in _dl_pending:
                    break
                time.sleep(0.1)
        return str(dest) if dest.exists() else ""
    if first:
        _DL_POOL.submit(_download, avatar_url(user), dest)
    return ""


def display_name(vs: dict) -> str:
    u = vs.get("user", {})
    return vs.get("nick") or u.get("global_name") or u.get("username") or "?"


def member(vs: dict, speaking: set) -> dict:
    u, v = vs.get("user", {}), vs.get("voice_state", {})
    return {
        "id": u.get("id"),
        "name": display_name(vs),
        "avatar": avatar_url(u),
        "avatar_file": avatar_file(u),
        "muted": bool(v.get("self_mute") or v.get("mute")),
        "deafened": bool(v.get("self_deaf") or v.get("deaf")),
        "speaking": u.get("id") in speaking,
    }


VOICE_EVENTS = ("VOICE_STATE_CREATE", "VOICE_STATE_UPDATE", "VOICE_STATE_DELETE", "SPEAKING_START", "SPEAKING_STOP")


def call_many(rpc, calls, timeout=8):
    """Plusieurs appels RPC en parallèle (le RPC multiplexe par nonce). -> liste de résultats (None si erreur)."""
    futs = [_RPC_POOL.submit(rpc.call, cmd, args, evt, timeout) for cmd, args, evt in calls]
    out = []
    for f in futs:
        try:
            out.append(f.result())
        except Exception:
            out.append(None)
    return out


class State:
    def __init__(self, rpc: RPC):
        self.rpc = rpc
        self.channel = None
        self.members = {}
        self.speaking = set()
        self.voice = {}
        self.sub_channel = None
        self.guild_names = {}

    def refresh(self):
        self.voice, ch = call_many(self.rpc, [("GET_VOICE_SETTINGS", None, None),
                                              ("GET_SELECTED_VOICE_CHANNEL", None, None)])
        self.voice = self.voice or {}
        self.set_channel(ch or None)

    def set_channel(self, ch):
        calls = []
        if self.sub_channel and (not ch or ch.get("id") != self.sub_channel):
            calls += [("UNSUBSCRIBE", {"channel_id": self.sub_channel}, evt) for evt in VOICE_EVENTS]
            self.sub_channel = None
        self.channel = ch
        self.speaking.clear()
        self.members = {vs["user"]["id"]: vs for vs in (ch or {}).get("voice_states", []) if vs.get("user")}
        if ch and self.sub_channel != ch.get("id"):
            calls += [("SUBSCRIBE", {"channel_id": ch["id"]}, evt) for evt in VOICE_EVENTS]
            self.sub_channel = ch["id"]
        if calls:
            call_many(self.rpc, calls, timeout=5)

    def guild_name(self):
        gid = (self.channel or {}).get("guild_id")
        if not gid:
            return "Appel privé"
        if gid not in self.guild_names:
            try:
                self.guild_names[gid] = self.rpc.call("GET_GUILD", {"guild_id": gid}, timeout=5).get("name", "")
            except Exception:
                return ""
        return self.guild_names[gid]

    def snapshot(self, guild=None) -> dict:
        ch = self.channel
        return {
            "type": "state", "ok": True,
            "in_voice": ch is not None,
            "channel": {"id": ch.get("id"), "name": ch.get("name") or "Appel", "guild": guild if guild is not None else ""} if ch else None,
            "members": sorted((member(vs, self.speaking) for vs in self.members.values()), key=lambda m: m["name"].lower()),
            "self": {"mute": bool(self.voice.get("mute")), "deaf": bool(self.voice.get("deaf"))},
            "me": self.me(),
        }

    def me(self) -> dict:
        u = getattr(self.rpc, "me", None) or {}
        if not u:
            return {}
        return {"name": u.get("global_name") or u.get("username") or "", "avatar_file": avatar_file(u)}


# --------------------------------------------------------- vocaux des amis

class Scanner:
    """Salons vocaux occupés, tous serveurs, en parallèle. Liste des salons de chaque serveur
    gardée 10 min (elle bouge rarement) ; amis (relationships) gardés 5 min."""

    def __init__(self, rpc: RPC):
        self.rpc = rpc
        self.guilds = []
        self.voice_chans = {}   # guild_id -> (t, [salons vocaux])
        self.friends = None     # set d'ids, ou None si Discord refuse (scope manquant)
        self.friends_t = 0
        self.last = None        # dernier résultat (renvoyé tout de suite à l'ouverture du menu)
        self.lock = threading.Lock()

    def load_friends(self):
        # Discord refuse le scope relationships.read aux apps non validées :
        # les amis sont ceux que tu as marqués d'une étoile dans le menu
        data = load(FRIENDS)
        ids = data.get("ids", {})
        self.friends = set(ids) if ids else None
        self.pins = set(data.get("channels", {}))

    @staticmethod
    def set_mark(kind: str, key: str, name: str, on: bool):
        """kind = "ids" (ami ☆) ou "channels" (vocal épinglé 📌)."""
        data = load(FRIENDS)
        marks = data.setdefault(kind, {})
        if on:
            marks[str(key)] = name
        else:
            marks.pop(str(key), None)
        save_private(FRIENDS, {"ids": data.get("ids", {}), "channels": data.get("channels", {})})

    def scan(self, friends_only=True) -> dict:
        with self.lock:
            t0 = time.time()
            self.load_friends()
            if not self.guilds or t0 - getattr(self, "guilds_t", 0) > 600:
                self.guilds = self.rpc.call("GET_GUILDS").get("guilds", [])
                self.guilds_t = t0
            gnames = {g["id"]: g.get("name", "") for g in self.guilds}
            stale = [g["id"] for g in self.guilds if t0 - self.voice_chans.get(g["id"], (0,))[0] > 600]
            for gid, res in zip(stale, call_many(self.rpc, [("GET_CHANNELS", {"guild_id": gid}, None) for gid in stale])):
                if res is not None:
                    self.voice_chans[gid] = (t0, [c for c in res.get("channels", []) if c.get("type") in VOICE_TYPES])
            chans = [(gid, c) for gid in gnames for c in self.voice_chans.get(gid, (0, []))[1]]
            fulls = call_many(self.rpc, [("GET_CHANNEL", {"channel_id": c["id"]}, None) for _, c in chans], timeout=5)
            items, users = [], {}
            me = (getattr(self.rpc, "me", None) or {}).get("id")
            for (gid, c), full in zip(chans, fulls):
                vss = [vs for vs in (full or {}).get("voice_states", []) if vs.get("user")]
                if not vss:
                    continue
                people = []
                for vs in vss:
                    uid = vs["user"]["id"]
                    users[uid] = vs["user"]
                    people.append({"id": uid, "name": display_name(vs), "me": uid == me,
                                   "friend": self.friends is not None and uid in self.friends})
                people.sort(key=lambda p: (not p["friend"], p["name"].lower()))
                friends = [p for p in people if p["friend"]] if self.friends is not None else people
                pinned = c["id"] in self.pins
                filtering = self.friends is not None or bool(self.pins)
                if friends_only and filtering and not pinned and not (self.friends is not None and friends):
                    continue
                items.append({"id": c["id"], "name": c.get("name", "?"), "guild": gnames.get(gid, ""),
                              "pinned": pinned, "friends": friends, "people": people,
                              "others": len(people) - len(friends),
                              "members": [p["name"] for p in people]})
            # avatars : téléchargés en parallèle (cache disque ensuite)
            needed = {p["id"] for it in items for p in it["people"]}
            paths = dict(zip(needed, _DL_POOL.map(lambda uid: avatar_file(users[uid], wait=True), needed)))
            for it in items:
                for p in it["people"]:
                    p["avatar_file"] = paths.get(p["id"], "")
            items.sort(key=lambda it: (not it["pinned"], -len(it["friends"]), it["guild"].lower(), it["name"].lower()))
            self.last = {"type": "channels", "items": items, "friends_known": self.friends is not None or bool(self.pins),
                         "took_ms": int((time.time() - t0) * 1000)}
            return self.last


def occupied_channels(rpc: RPC) -> list:
    return Scanner(rpc).scan(friends_only=False)["items"]


def run_command(rpc: RPC, state: "State | None", cmd: dict):
    c = cmd.get("cmd")
    voice = state.voice if state is not None and state.voice else rpc.call("GET_VOICE_SETTINGS")
    if c == "mute":
        rpc.call("SET_VOICE_SETTINGS", {"mute": not voice.get("mute")})
    elif c == "deaf":
        rpc.call("SET_VOICE_SETTINGS", {"deaf": not voice.get("deaf")})
    elif c == "disconnect":
        rpc.call("SELECT_VOICE_CHANNEL", {"channel_id": None})
    elif c == "join" and cmd.get("id"):
        rpc.call("SELECT_VOICE_CHANNEL", {"channel_id": str(cmd["id"]), "force": True}, timeout=20)
    return None


# -------------------------------------------------------------------- démon

_emit_lock = threading.Lock()


def emit(obj):
    line = json.dumps(obj, ensure_ascii=False) + "\n"
    with _emit_lock:
        sys.stdout.write(line)
        sys.stdout.flush()


def daemon():
    global on_avatar_ready
    while True:
        try:
            events = queue.Queue()
            rpc = connect(lambda evt, data: events.put((evt, data)))
            state = State(rpc)
            scanner = Scanner(rpc)
            on_avatar_ready = lambda: events.put(("__AVATAR__", {}))
            call_many(rpc, [("SUBSCRIBE", {}, evt) for evt in ("VOICE_SETTINGS_UPDATE", "VOICE_CHANNEL_SELECT")])
            state.refresh()
            guild = state.guild_name()
            emit(state.snapshot(guild))
            # pré-scan en arrière-plan : le menu « Rejoindre » s'ouvre déjà rempli
            _POOL.submit(lambda: emit(scanner.scan()))

            def stdin_reader():
                for line in sys.stdin:
                    try:
                        events.put(("__CMD__", json.loads(line)))
                    except ValueError:
                        pass
                events.put(("__EOF__", {}))
            threading.Thread(target=stdin_reader, daemon=True).start()

            def do_command(data):
                try:
                    if data.get("cmd") in ("friend", "pin") and data.get("id"):
                        Scanner.set_mark("ids" if data["cmd"] == "friend" else "channels",
                                         data["id"], data.get("name", ""), bool(data.get("on")))
                        emit(scanner.scan())
                    elif data.get("cmd") == "channels":
                        if scanner.last:
                            emit(scanner.last)          # tout de suite le dernier résultat…
                        emit(scanner.scan())            # …puis le résultat frais
                    else:
                        run_command(rpc, state, data)
                except Exception as e:
                    emit({"type": "error", "message": str(e)})

            while True:
                evt, data = events.get()
                dirty = speaking_only = False
                # on traite tout ce qui est déjà arrivé, puis UN seul envoi
                while True:
                    if evt == "__EOF__":
                        return
                    if evt == "__CLOSED__":
                        raise ConnectionError("Discord fermé")
                    if evt == "__CMD__":
                        # en tâche de fond : un « rejoindre » lent ne gèle plus l'îlot
                        _POOL.submit(do_command, data)
                    elif evt == "VOICE_SETTINGS_UPDATE":
                        state.voice = data
                        dirty = True
                    elif evt == "VOICE_CHANNEL_SELECT":
                        state.refresh()
                        guild = state.guild_name()
                        dirty = True
                    elif evt in ("VOICE_STATE_CREATE", "VOICE_STATE_UPDATE") and data.get("user"):
                        state.members[data["user"]["id"]] = data
                        dirty = True
                    elif evt == "VOICE_STATE_DELETE" and data.get("user"):
                        state.members.pop(data["user"]["id"], None)
                        dirty = True
                    elif evt in ("SPEAKING_START", "SPEAKING_STOP"):
                        (state.speaking.add if evt == "SPEAKING_START" else state.speaking.discard)(data.get("user_id"))
                        speaking_only = True
                    elif evt == "__AVATAR__":
                        dirty = True
                    try:
                        evt, data = events.get_nowait()
                    except queue.Empty:
                        break
                if dirty:
                    emit(state.snapshot(guild))
                elif speaking_only:
                    # message léger : l'extension ne fait que changer les anneaux, sans tout reconstruire
                    emit({"type": "speaking", "ids": sorted(i for i in state.speaking if i)})
        except PermissionError as e:
            emit({"type": "state", "ok": False, "reason": "setup", "message": str(e)})
            time.sleep(30)
        except Exception as e:
            emit({"type": "state", "ok": False, "reason": "offline", "message": str(e)})
            time.sleep(5)


# --------------------------------------------------------------------- main

def ask_credentials():
    """Au clavier dans un vrai terminal ; sinon (ex. lancé sans terminal) via des fenêtres zenity."""
    if sys.stdin.isatty():
        cid = input("Client ID de ton app Discord : ").strip()
        return cid, getpass.getpass("Client secret (non affiché) : ").strip()
    import shutil
    import subprocess
    if not shutil.which("zenity"):
        sys.exit("zdiscord: lance « zdiscord setup » dans un terminal (pas de saisie possible ici)")
    def ask(*args):
        r = subprocess.run(["zenity", *args, "--title=Discord — configuration"], capture_output=True, text=True)
        return r.stdout.strip() if r.returncode == 0 else ""
    cid = ask("--entry", "--text=Client ID de ton app Discord :")
    secret = ask("--password", "--text=Client Secret (masqué) :") if cid else ""
    return cid, secret



def main():
    a = sys.argv[1:]
    if not a:
        sys.exit(__doc__)
    try:
        if a[0] == "setup":
            cid, secret = ask_credentials()
            if not cid.isdigit() or not secret:
                sys.exit("zdiscord: Client ID (chiffres) et secret obligatoires — rien n'a été enregistré")
            save_private(SETTINGS, {"client_id": cid, "client_secret": secret})
            print("Enregistré. Lance maintenant : zdiscord login")
        elif a[0] == "login":
            login()
        elif a[0] == "daemon":
            daemon()
        elif a[0] == "status":
            rpc = connect()
            st = State(rpc)
            st.refresh()
            print(json.dumps(st.snapshot(st.guild_name()), ensure_ascii=False, indent=2))
        elif a[0] == "channels":
            print(json.dumps(occupied_channels(connect()), ensure_ascii=False, indent=2))
        elif a[0] in ("mute", "deaf", "disconnect"):
            run_command(connect(), None, {"cmd": a[0]})
        elif a[0] == "join" and len(a) > 1:
            run_command(connect(), None, {"cmd": "join", "id": a[1]})
        else:
            sys.exit(__doc__)
    except (PermissionError, ConnectionError, RuntimeError, TimeoutError) as e:
        sys.exit(f"zdiscord: {e}")


if __name__ == "__main__":
    main()
